{
  "name": "litevolve-bun",
  "version": "0.0.2",
  "description": "Versioned SQLite migration runner for Bun — library or CLI.",
  "type": "module",
  "exports": {
    ".": {
      "bun": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "bun": "1.3.14"
  },
  "license": "MIT",
  "author": "ccarcaci",
  "homepage": "https://github.com/ccarcaci/litevolve#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccarcaci/litevolve.git",
    "directory": "runtimes/bun"
  },
  "keywords": [
    "sqlite",
    "migration",
    "migrations",
    "schema",
    "database",
    "bun"
  ],
  "publishConfig": {
    "provenance": true
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@changesets/cli": "2.31.1",
    "@types/bun": "1.3.14"
  }
}
